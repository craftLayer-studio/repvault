{
  "name": "repvault",
  "version": "0.1.0",
  "private": true,
  "description": "QR check-in, trial leads, renewals and churn alerts for Indian gyms and studios. MVP.",
  "scripts": {
    "dev": "next dev --webpack -p 3142",
    "build": "next build --webpack",
    "start": "next start",
