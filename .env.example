# Public base URL used in QR codes and WhatsApp links.
# Production: https://repvault.craftlayer.store  Dev: http://localhost:3142
APP_URL=http://localhost:3142

# 32+ random characters. Signs the staff session cookie. A dev fallback is used (with a warning) if unset.
SESSION_SECRET=

# Optional. When set, use this Postgres instead of the local PGlite file DB in ./.data/pglite.
# DATABASE_URL=postgres://user:pass@localhost:5432/repvault

# Demo mode shows staff OTPs on screen. Set to "off" once a real SMS adapter exists.
DEMO_MODE=on
